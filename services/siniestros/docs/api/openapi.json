{
  "openapi": "3.1.0",
  "info": {
    "title": "Solventa — MS Siniestros",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/siniestros/eventos": {
      "post": {
        "tags": [
          "siniestros"
        ],
        "summary": "Recibir un evento paramétrico de vuelos o clima",
        "operationId": "recibir_evento_v1_siniestros_eventos_post",
        "parameters": [
          {
            "name": "x-service-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Key"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcuseOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "Tipos aceptados: inundacion, sequia, sismo, tormenta, vuelo_cancelado, vuelo_retrasado",
                "examples": [
                  {
                    "datos": {
                      "latitud": 4.71,
                      "longitud": -74.07,
                      "magnitud": 6.4
                    },
                    "evento_id": "evt-2026-10-23-0001",
                    "fuente": "proveedor-sismos",
                    "ocurrido_en": "2026-10-23T14:05:00Z",
                    "tipo": "sismo"
                  }
                ],
                "properties": {
                  "evento_id": {
                    "title": "Evento Id",
                    "type": "string"
                  },
                  "tipo": {
                    "title": "Tipo",
                    "type": "string"
                  },
                  "fuente": {
                    "title": "Fuente",
                    "type": "string"
                  },
                  "ocurrido_en": {
                    "title": "Ocurrido En",
                    "type": "string"
                  },
                  "datos": {
                    "additionalProperties": true,
                    "title": "Datos",
                    "type": "object"
                  },
                  "poliza_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Poliza Id"
                  }
                },
                "required": [
                  "evento_id",
                  "tipo",
                  "fuente",
                  "ocurrido_en",
                  "datos"
                ],
                "title": "EventoIn",
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/v1/siniestros/eventos/resumen": {
      "get": {
        "tags": [
          "siniestros"
        ],
        "summary": "Conteos de eventos recibidos, publicados y procesados (verificación de ráfagas)",
        "operationId": "resumen_v1_siniestros_eventos_resumen_get",
        "parameters": [
          {
            "name": "x-service-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumenOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/siniestros/evaluaciones": {
      "get": {
        "tags": [
          "siniestros"
        ],
        "summary": "Resultado de validar la condición paramétrica de los eventos recibidos (HU28)",
        "description": "Solo lectura. Devuelve únicamente las evaluaciones de eventos que recibió la fuente de la llave.\n\nMuestra, por cada par evento–póliza, el resultado, el motivo, los valores evaluados, la versión de las\nreglas y el id del comando emitido (nulo si no corresponde pago). Aparece cuando el consumidor ya procesó el evento.",
        "operationId": "evaluaciones_v1_siniestros_evaluaciones_get",
        "parameters": [
          {
            "name": "evento_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "description": "El evento_id que asignó el proveedor",
              "title": "Evento Id"
            },
            "description": "El evento_id que asignó el proveedor"
          },
          {
            "name": "poliza_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "title": "Poliza Id"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limite"
            }
          },
          {
            "name": "x-service-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EvaluacionOut"
                  },
                  "title": "Response Evaluaciones V1 Siniestros Evaluaciones Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/siniestros/polizas-demo": {
      "post": {
        "tags": [
          "siniestros"
        ],
        "summary": "Sembrar pólizas paramétricas de prueba (solo ambientes de prueba)",
        "description": "Crea o actualiza pólizas en la copia local, sin pasar por `poliza_emitida`. Idempotente por `poliza_id`.\n\nSolo acepta ids `pol-demo-*` y productos que existan en el archivo de reglas. Responde 404 si el ambiente\nno habilitó la siembra.",
        "operationId": "sembrar_polizas_v1_siniestros_polizas_demo_post",
        "parameters": [
          {
            "name": "x-service-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SiembraIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiembraOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "siniestros"
        ],
        "summary": "Borrar las pólizas de prueba sembradas (solo `pol-demo-*`)",
        "description": "No toca pólizas reales ni las evaluaciones ya registradas (solo inserción).",
        "operationId": "borrar_polizas_demo_v1_siniestros_polizas_demo_delete",
        "parameters": [
          {
            "name": "x-service-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BorradoOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcuseOut": {
        "properties": {
          "evento_uuid": {
            "type": "string",
            "title": "Evento Uuid"
          },
          "evento_id": {
            "type": "string",
            "title": "Evento Id"
          },
          "estado": {
            "type": "string",
            "title": "Estado"
          },
          "duplicado": {
            "type": "boolean",
            "title": "Duplicado"
          },
          "recibido_en": {
            "type": "string",
            "title": "Recibido En"
          }
        },
        "type": "object",
        "required": [
          "evento_uuid",
          "evento_id",
          "estado",
          "duplicado",
          "recibido_en"
        ],
        "title": "AcuseOut"
      },
      "BorradoOut": {
        "properties": {
          "borradas": {
            "type": "integer",
            "title": "Borradas"
          }
        },
        "type": "object",
        "required": [
          "borradas"
        ],
        "title": "BorradoOut"
      },
      "EvaluacionOut": {
        "properties": {
          "evento_id": {
            "type": "string",
            "title": "Evento Id"
          },
          "evento_uuid": {
            "type": "string",
            "title": "Evento Uuid"
          },
          "poliza_id": {
            "type": "string",
            "title": "Poliza Id"
          },
          "resultado": {
            "type": "string",
            "title": "Resultado"
          },
          "motivo": {
            "type": "string",
            "title": "Motivo"
          },
          "valores": {
            "additionalProperties": true,
            "type": "object",
            "title": "Valores"
          },
          "version_reglas": {
            "type": "string",
            "title": "Version Reglas"
          },
          "comando_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comando Id"
          },
          "evaluado_en": {
            "type": "string",
            "title": "Evaluado En"
          }
        },
        "type": "object",
        "required": [
          "evento_id",
          "evento_uuid",
          "poliza_id",
          "resultado",
          "motivo",
          "valores",
          "version_reglas",
          "comando_id",
          "evaluado_en"
        ],
        "title": "EvaluacionOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PolizaDemoIn": {
        "properties": {
          "poliza_id": {
            "type": "string",
            "pattern": "^pol-demo-[A-Za-z0-9_-]{1,50}$",
            "title": "Poliza Id",
            "description": "Debe empezar por `pol-demo-`"
          },
          "producto": {
            "type": "string",
            "title": "Producto"
          },
          "zona": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Zona"
          },
          "vigencia_desde": {
            "type": "string",
            "format": "date-time",
            "title": "Vigencia Desde"
          },
          "fecha_vencimiento": {
            "type": "string",
            "format": "date-time",
            "title": "Fecha Vencimiento"
          }
        },
        "type": "object",
        "required": [
          "poliza_id",
          "producto",
          "vigencia_desde",
          "fecha_vencimiento"
        ],
        "title": "PolizaDemoIn"
      },
      "ResumenOut": {
        "properties": {
          "recibidos": {
            "type": "integer",
            "title": "Recibidos"
          },
          "rechazados": {
            "type": "integer",
            "title": "Rechazados"
          },
          "publicados": {
            "type": "integer",
            "title": "Publicados"
          },
          "procesados": {
            "type": "integer",
            "title": "Procesados"
          },
          "reentregas": {
            "type": "integer",
            "title": "Reentregas"
          }
        },
        "type": "object",
        "required": [
          "recibidos",
          "rechazados",
          "publicados",
          "procesados",
          "reentregas"
        ],
        "title": "ResumenOut"
      },
      "SiembraIn": {
        "properties": {
          "polizas": {
            "items": {
              "$ref": "#/components/schemas/PolizaDemoIn"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Polizas"
          }
        },
        "type": "object",
        "required": [
          "polizas"
        ],
        "title": "SiembraIn"
      },
      "SiembraOut": {
        "properties": {
          "sembradas": {
            "type": "integer",
            "title": "Sembradas"
          }
        },
        "type": "object",
        "required": [
          "sembradas"
        ],
        "title": "SiembraOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
