    "/v1/pagos/cobros-fallidos": {
      "get": {
        "tags": [
          "cobros-fallidos"
        ],
        "summary": "Bandeja de cobros fallidos (los más urgentes primero)",
        "operationId": "bandeja_v1_pagos_cobros_fallidos_get",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "enum": [
                      "PENDIENTE",
                      "VENCIDO",
                      "RECUPERADO"
                    ],
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Por defecto, PENDIENTE y VENCIDO",
              "title": "Estado"
            },
            "description": "Por defecto, PENDIENTE y VENCIDO"
          },
          {
            "name": "por_vencer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Solo los que vencen en menos de 24 h (o ya vencidos)",
              "default": false,
              "title": "Por Vencer"
            },
            "description": "Solo los que vencen en menos de 24 h (o ya vencidos)"
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Pagina"
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Tamano"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaCasosOut"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token, no es válido o venció (sesión vencida).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "403": {
            "description": "El token no es de un asesor ni de un operador.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
