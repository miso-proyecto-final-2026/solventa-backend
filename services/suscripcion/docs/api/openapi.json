        "title": "PolizaResumenOut",
        "description": "La póliza dentro de la saga: lo que el operador necesita ver si el documento no se genera."
      },
      "SuscripcionIn": {
        "properties": {
          "cotizacion_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Cotizacion Id"
          },
          "metodo_pago": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Metodo Pago",
            "description": "Token de la pasarela; nunca el número de tarjeta"
          },
          "acepta_terminos": {
            "type": "boolean",
            "title": "Acepta Terminos"
          },
          "periodicidad_pago": {
            "type": "string",
            "enum": [
              "ANUAL",
              "MENSUAL"
            ],
            "title": "Periodicidad Pago",
            "description": "Cómo paga el cliente; se cobra el primer período (HU18)",
            "default": "ANUAL"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cotizacion_id",
          "metodo_pago",
          "acepta_terminos"
        ],
        "title": "SuscripcionIn"
      },
