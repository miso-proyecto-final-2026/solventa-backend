    "/v1/perfilamiento/{cliente_id}/oferta": {
      "get": {
        "tags": [
          "perfilamiento"
        ],
        "summary": "Oferta de vida hipotecario con el precio individualizado por el perfil (exige consentimiento vigente)",
        "operationId": "oferta_v1_perfilamiento__cliente_id__oferta_get",
        "parameters": [
          {
            "name": "cliente_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cliente Id"
            }
          },
          {
            "name": "suma_asegurada",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Saldo a asegurar en COP. Sin ella se usa el ingreso por los meses de las reglas.",
              "title": "Suma Asegurada"
            },
            "description": "Saldo a asegurar en COP. Sin ella se usa el ingreso por los meses de las reglas."
          },
          {
            "name": "x-service-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfertaOut"
                }
              }
            }
          },
          "404": {
            "description": "El cliente no tiene perfil enriquecido: no se inventa un precio."
          },
          "422": {
            "description": "Suma asegurada fuera de los límites de las reglas."
          }
        }
      }
    },
