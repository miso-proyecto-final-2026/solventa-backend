    "/v1/perfilamiento/{cliente_id}/linaje": {
      "get": {
        "tags": [
          "perfilamiento"
        ],
        "summary": "Linaje de un perfil (por defecto, el vigente), para auditoría",
        "description": "Fuentes, tipo de dato, fechas, TTL y marcas de caché o degradación, sin valores. Cada consulta queda registrada con el servicio que llamó y, si lo informa en `X-Consultado-Por`, la persona a cuyo nombre consulta.",
        "operationId": "linaje_v1_perfilamiento__cliente_id__linaje_get",
        "parameters": [
          {
            "name": "cliente_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cliente Id"
            }
          },
          {
            "name": "perfil_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36
                },
                {
                  "type": "null"
                }
              ],
              "description": "Un perfil concreto del cliente.",
              "title": "Perfil Id"
            },
            "description": "Un perfil concreto del cliente."
          },
          {
            "name": "x-consultado-por",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Id de la persona a cuyo nombre consulta el servicio (p. ej., el asesor).",
              "title": "X-Consultado-Por"
            },
            "description": "Id de la persona a cuyo nombre consulta el servicio (p. ej., el asesor)."
          },
          {
            "name": "x-service-key",
