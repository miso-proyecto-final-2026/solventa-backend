    "/v1/perfilamiento/{cliente_id}/enriquecer": {
      "post": {
        "tags": [
          "perfilamiento"
        ],
        "summary": "Enriquecer el perfil del cliente con Open Finance y Open Data",
        "operationId": "enriquecer_v1_perfilamiento__cliente_id__enriquecer_post",
        "parameters": [
          {
            "name": "cliente_id",
            "in": "path",
