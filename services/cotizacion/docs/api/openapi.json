          "cotizaciones"
        ],
        "summary": "Consulta una cotización emitida",
        "operationId": "obtener_cotizacion_v1_cotizaciones__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "title": "Id"
